#!/usr/bin/env bash
# Prints the acta rules for this session. It never blocks the session, so it
# always exits 0. When acta is missing or fails, it prints the default rules.
here="$(cd "$(dirname "$0")" && pwd)"
if command -v acta >/dev/null 2>&1; then
  acta hook session-start --known "$here/workflow-plugins.txt" && exit 0
fi
cat "$here/default-rules.md"
echo
echo "acta: the acta binary is not installed or failed, so these are the default rules (English, adhd style). Build it from the acta repo: go build -o \"\$(go env GOPATH)/bin/acta\" ./cmd/acta"
exit 0
